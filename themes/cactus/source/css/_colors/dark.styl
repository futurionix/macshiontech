// 深色主题配色优化方案
// 基色：现代深灰 + 活力渐变配色

$color-background = #0f1419      // 更深的背景色，对比度更好
$color-footer-mobile-1 = lighten($color-background, 3%)
$color-footer-mobile-2 = lighten($color-background, 12%)
$color-background-code = lighten($color-background, 4%)
$color-border = #333d47          // 更深的边框
$color-scrollbar = #4a5568
$color-meta = #64748b            // 灰色元字数据
$color-meta-code = #64748b
$color-link = #00d9ff             // 明亮的青色链接 - 对深色背景友好
$color-text = #e2e8f0             // 更亮的文字
$color-accent-3 = #cbd5e1
$color-accent-2 = #f1f5f9
$color-accent-1 = #10b981        // 活力绿色 - 更饱和
$color-quote = #86efac
$highlight = hexo-config("highlight") || "rainbow"
